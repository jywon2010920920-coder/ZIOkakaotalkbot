# 브롤스타즈 API 키 (https://developer.brawlstars.com)
BRAWL_API_KEY=your_brawl_stars_api_key_here

# 카카오톡 계정 (프로필 변경 감지용 — 전용 봇 계정 권장)
KAKAO_EMAIL=your_kakao_email@example.com
KAKAO_PASSWORD=your_kakao_password
KAKAO_ROOM_ID=12345678   # 오픈채팅 URL의 숫자 (예: open.kakao.com/o/gXXXXXXX → linkId 숫자)

# 서버 포트 (클라우드는 자동 주입)
PORT=8000
